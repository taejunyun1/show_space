    "@react-three/drei": "10.7.0",
    "@react-three/fiber": "9.3.0",
    "@supabase/supabase-js": "2.117.2",
    "idb-keyval": "6.2.2",
    "jszip": "3.10.2",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "7.0.0",
    "three": "0.180.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.0",
    "fake-indexeddb": "6.2.5",

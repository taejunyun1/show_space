{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gonggan-exhibition-preview",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [{"binding":"SHARES","bucket_name":"gonggan-exhibition-shares"}],
  "account_id": "a58fbe3a0082c49f571d69d08c1227ab"
}
